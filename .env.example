# Lấy trong Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chỉ cần khi dùng webhook quà TikTok (giữ bí mật, không bao giờ đưa cho học sinh)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Chuỗi bí mật tự đặt, gắn vào đường link webhook: /api/qua-tiktok?key=...
TIKTOK_WEBHOOK_SECRET=doi-chuoi-nay-thanh-chuoi-dai-kho-doan
# Tên quà được tính là hương (phân cách bằng dấu phẩy, không phân biệt hoa thường)
TIKTOK_GIFT_NAMES=rose,hoa hồng
# Mỗi bông hồng đổi được bao nhiêu nén hương
HUONG_PER_GIFT=1

# Tùy chọn: bật "Hỏi Ông Tổ" bằng AI (Claude API, tính phí theo lượt dùng)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
